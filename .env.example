# Copy this file to ".env" and fill in your key. Never commit ".env".

# Free Groq key: https://console.groq.com/keys
API_KEY=

# Any OpenAI-compatible API works. Default: Groq.
# To use OpenAI instead: API_BASE_URL=https://api.openai.com/v1 (and OpenAI model names below)
API_BASE_URL=https://api.groq.com/openai/v1

# Speech-to-text model (Whisper)
#   whisper-large-v3-turbo -> faster
#   whisper-large-v3       -> a bit more accurate, slower
TRANSCRIBE_MODEL=whisper-large-v3-turbo

# Chat model used for the summaries
SUMMARY_MODEL=openai/gpt-oss-120b

# Reasoning effort for reasoning models (low / medium / high).
# "low" keeps token usage small on the free tier. Leave empty for non-reasoning models.
REASONING_EFFORT=low
